# === DB ===
DATABASE_URL=postgresql://nextderboy@localhost:5432/walmart_audit

# === Amazon Scraper v3（阿里云 /amazon 反代）===
DMIT_BASE_URL=http://47.108.92.213/amazon
DMIT_API_KEY=

# === LLM (阿里云 DashScope, OpenAI 兼容) ===
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEXT_MODEL=qwen-plus
LLM_VISION_MODEL=qwen-vl-plus

# === 文本 provider 切换 (dashscope | deepseek) — 影响 L1 / L3 ===
LLM_TEXT_PROVIDER=deepseek

# === DeepSeek (api.deepseek.com, OpenAI 兼容) ===
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_L1=
DEEPSEEK_API_KEY_L3=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# L1 类目判定模型 (默认 deepseek-v4-flash; 路由体系启用后仅作 legacy 合成输入)
L1_TEXT_MODEL=deepseek-v4-flash

# === 火山方舟 (豆包视觉) ===
VISION_PROVIDER=volcengine
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_VISION_MODEL=doubao-seed-1-6-flash-250615

# === LLM 路由与故障切换 (integrations/llm_routes.py / llm_router.py) ===
# 注: 路由是唯一调用路径, 无开关 (2026-08 起旧 client 双轨已删除, 回滚靠 git revert)
# 路由配置文件 (不存在时从上面的 env 自动合成等价单节点链, 零配置可用)
# 模板: config/llm_routes.yaml.example; 修改后先跑 python -m integrations.llm_routes --check 再重启 worker
LLM_ROUTES_FILE=config/llm_routes.yaml
# 第三方聚合网关 key 示例 (llm_routes.yaml 的 endpoints.*.keys 引用的环境变量名)
# ONEAPI_KEY=
# 飞书告警: 自定义机器人 webhook URL (留空 = 不发告警, 只落 llm_route_events 表)
LARK_ALERT_WEBHOOK=

# === 飞书 lark-cli (使用系统已配置的 identity) ===
# 无需额外配置;通过 subprocess 调 lark-cli

# === 飞书表定位 (换表只改这里, 代码里没有任何表 ID) ===
# 每张表三个维度, 都可单独覆盖:
#   LARK_<名字>_TOKEN      父表 token (飞书链接里 /wiki/ 或 /sheets/ 后面那串)
#   LARK_<名字>_SHEET_ID   子表 ID   (链接 ?sheet=xxx; 留空 = 运行时按表名动态找)
#   LARK_<名字>_LAST_COL   读取列上界字母 (表加宽了才需要改)
# 不配则用代码内置默认值 —— 换环境后务必跑 python -m config --check 逐项确认
LARK_BLACKLIST_BRANDS_TOKEN=UhZJw3EtsiFN9skbG0Ac24Dgn4b
LARK_CATEGORY_MAP_TOKEN=UKdZwr7JqiO6UckjSnPcwTCgnvd
LARK_CATEGORY_MAP_SHEET_ID=2p5sL6
LARK_CATEGORY_MAP_LAST_COL=K
# 禁售政策 / PT 元数据与类目映射同父表, 不同子表
LARK_PROHIBITED_TOKEN=UKdZwr7JqiO6UckjSnPcwTCgnvd
LARK_PROHIBITED_SHEET_ID=OJSrkV
LARK_PROHIBITED_LAST_COL=N
LARK_PT_META_TOKEN=UKdZwr7JqiO6UckjSnPcwTCgnvd
LARK_PT_META_SHEET_ID=0bdc8b
LARK_PT_META_LAST_COL=J
# 违规日报: sheet_id 留空 — 按 "YYYY.M.D问题商品" 表名逐日动态查找
LARK_VIOLATION_DAILY_TOKEN=YlA1szPAAhW7CCtmG5hcp6vkndd
LARK_VIOLATION_DAILY_LAST_COL=M
LARK_PHASE0_BLACKLIST_TOKEN=QNIpwrRWxiYPeVk86f8cemyenBb
LARK_PHASE0_BLACKLIST_SHEET_ID=8280e8
LARK_PHASE0_BLACKLIST_LAST_COL=C
# 批量审核任务表 (读 ASIN + 回写审核结果)
LARK_AUDIT_TASK_TOKEN=MO2escopjhLFzVtOzVlcq8xvnmI
LARK_AUDIT_TASK_SHEET_ID=e7834a

# 旧变量名 (仍生效, 作为上面 *_TOKEN 的默认值; 新部署直接用上面的)
# LARK_WIKI_BLACKLIST=
# LARK_WIKI_CATEGORY_MAP=
# LARK_SHEET_VIOLATION=

# === USPTO 旧库 (LIVE 商标表在此, 沿用) ===
USPTO_DATABASE_URL=postgresql://nextderboy@localhost:5432/uspto

# === 分布式队列 (server + worker) ===
# server 地址: worker / cron 巡检脚本都读它 (换服务器只改这一处)
AUDIT_SERVER_URL=http://127.0.0.1:8200
# WORKER_ID=
# RUN_L4=false
# 切片自动重新入队上限 (心跳超时/worker 中断时自动重试, 超过才标 failed 等人工)
# AUDIT_MAX_AUTO_REQUEUE=2
# cron 巡检期望的 worker 数 / 启动数量 / 项目目录 (供 scripts/_cron_*.sh 用)
# AUDIT_EXPECTED_WORKERS=10
# AUDIT_WORKER_COUNT=10
# AUDIT_PROJECT_DIR=/path/to/walmart-audit-system

# === 运行参数 ===
SCORE_THRESHOLD=60
LLM_CONCURRENCY=100
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1
L4_MAX_IMAGES_PER_PRODUCT=5
LOG_LEVEL=INFO
# 历史短路: pass 在最近一次真实 pass 距今 < 该天数时直接复用 (reject 永久短路无视此值)
SHORTCUT_PASS_TTL_DAYS=45
