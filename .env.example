# === DB ===
DATABASE_URL=postgresql://nextderboy@localhost:5432/walmart_audit

# === Amazon Scraper v3（阿里云 /amazon 反代）===
DMIT_BASE_URL=http://47.108.92.213/amazon
DMIT_API_KEY=

# === LLM (阿里云 DashScope, OpenAI 兼容) ===
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEXT_MODEL=qwen-plus
LLM_VISION_MODEL=qwen-vl-plus

# === 文本 provider 切换 (dashscope | deepseek) — 影响 L1 / L3 ===
LLM_TEXT_PROVIDER=deepseek

# === DeepSeek (api.deepseek.com, OpenAI 兼容) ===
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_L1=
DEEPSEEK_API_KEY_L3=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# L1 类目判定模型 (默认 deepseek-v4-flash; 路由体系启用后仅作 legacy 合成输入)
L1_TEXT_MODEL=deepseek-v4-flash

# === 火山方舟 (豆包视觉) ===
VISION_PROVIDER=volcengine
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_VISION_MODEL=doubao-seed-1-6-flash-250615

# === LLM 路由与故障切换 (integrations/llm_routes.py / llm_router.py) ===
# 注: 路由是唯一调用路径, 无开关 (2026-08 起旧 client 双轨已删除, 回滚靠 git revert)
# 路由配置文件 (不存在时从上面的 env 自动合成等价单节点链, 零配置可用)
# 模板: config/llm_routes.yaml.example; 修改后先跑 python -m integrations.llm_routes --check 再重启 worker
LLM_ROUTES_FILE=config/llm_routes.yaml
# 第三方聚合网关 key 示例 (llm_routes.yaml 的 endpoints.*.keys 引用的环境变量名)
# ONEAPI_KEY=
# 飞书告警: 自定义机器人 webhook URL (留空 = 不发告警, 只落 llm_route_events 表)
LARK_ALERT_WEBHOOK=

# === 飞书 lark-cli (使用系统已配置的 identity) ===
# 无需额外配置;通过 subprocess 调 lark-cli

# === 外部同步目标 ===
LARK_WIKI_BLACKLIST=UhZJw3EtsiFN9skbG0Ac24Dgn4b
LARK_WIKI_CATEGORY_MAP=UKdZwr7JqiO6UckjSnPcwTCgnvd
LARK_SHEET_VIOLATION=YlA1szPAAhW7CCtmG5hcp6vkndd

# === USPTO 旧库 (LIVE 商标表在此, 沿用) ===
USPTO_DATABASE_URL=postgresql://nextderboy@localhost:5432/uspto

# === 分布式队列 (server + worker) ===
# AUDIT_SERVER_URL=http://localhost:8200
# WORKER_ID=
# RUN_L4=false
# 切片自动重新入队上限 (心跳超时/worker 中断时自动重试, 超过才标 failed 等人工)
# AUDIT_MAX_AUTO_REQUEUE=2

# === 运行参数 ===
SCORE_THRESHOLD=60
LLM_CONCURRENCY=100
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1
L4_MAX_IMAGES_PER_PRODUCT=5
LOG_LEVEL=INFO
# 历史短路: pass 在最近一次真实 pass 距今 < 该天数时直接复用 (reject 永久短路无视此值)
SHORTCUT_PASS_TTL_DAYS=45
